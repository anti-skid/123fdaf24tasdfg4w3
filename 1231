--[[
  ПЕРЕХВАТ СЕТЕВЫХ ПАКЕТОВ
]]
function hookNetworkPackets()
    local mt = getrawmetatable(game)
    local oldNamecall = mt.__namecall
    
    setreadonly(mt, false)
    
    mt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        
        if bypassEnabled and method == "FireServer" then
            local args = {...}
            local remoteName = tostring(self)
            
            if remoteName:find("Mouse") or remoteName:find("Input") or 
               remoteName:find("Move") or remoteName:find("Walk") then
               
                return simulateLegitimateMovement(oldNamecall, self, args)
            end
        end
        
        return oldNamecall(self, ...)
    end)
    
    setreadonly(mt, true)
    table.insert(networkHooks, oldNamecall)
end

--[[
  СИМУЛЯЦИЯ ЛЕГИТИМНОГО ДВИЖЕНИЯ
]]
function simulateLegitimateMovement(originalFunc, remote, args)
    if not characterCache.rootPart then 
        return originalFunc(remote, unpack(args)) 
    end
    
    local currentPos = characterCache.rootPart.Position
    local modifiedArgs = {}
    
    for i, arg in ipairs(args) do
        if typeof(arg) == "Vector3" then
            -- Находим ближайшую допустимую позицию из истории
            local legitimatePos = findLegitimatePosition(currentPos)
            modifiedArgs[i] = legitimatePos
        elseif typeof(arg) == "CFrame" then
            local legitimatePos = findLegitimatePosition(currentPos)
            modifiedArgs[i] = CFrame.new(legitimatePos)
        else
            modifiedArgs[i] = arg
        end
    end
    
    return originalFunc(remote, unpack(modifiedArgs))
end

--[[
  ПОИСК ЛЕГИТИМНОЙ ПОЗИЦИИ
]]
function findLegitimatePosition(targetPos)
    if #POSITION_HISTORY == 0 then return targetPos end
    
    -- Ищем последнюю позицию в пределах лимита
    for i = #POSITION_HISTORY, 1, -1 do
        local historicalPos = POSITION_HISTORY[i].position
        local distance = (targetPos - historicalPos).Magnitude
        local timeDiff = tick() - POSITION_HISTORY[i].time
        
        if timeDiff <= 0.1 and distance <= MAX_ALLOWED_DISTANCE then
            return historicalPos
        end
    end
    
    -- Если не нашли - создаем промежуточную позицию
    local lastValidPos = POSITION_HISTORY[#POSITION_HISTORY].position
    local direction = (targetPos - lastValidPos).Unit
    return lastValidPos + direction * math.min(MAX_ALLOWED_DISTANCE, (targetPos - lastValidPos).Magnitude)
end

--[[
  ИНИЦИАЛИЗАЦИЯ ПЕРСОНАЖА
]]
function setupCharacterTracking()
    local player = Players.LocalPlayer
    
    local function onCharacterAdded(character)
        local rootPart
        repeat
            rootPart = character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Torso")
            task.wait(0.1)
        until rootPart or not character.Parent
        
        if not rootPart then return end
        
        characterCache.rootPart = rootPart
        characterCache.character = character
        
        -- Начальная позиция
        table.insert(POSITION_HISTORY, {
            position = rootPart.Position,
            time = tick()
        })
    end
    
    if player.Character then
        onCharacterAdded(player.Character)
    end
    
    player.CharacterAdded:Connect(onCharacterAdded)
end

--[[
  API УПРАВЛЕНИЯ
]]
function SpeedBypass:Enable()
    if bypassEnabled then return end
    
    bypassEnabled = true
    table.clear(POSITION_HISTORY)
    
    setupCharacterTracking()
    task.wait(1)
    hookNetworkPackets()
    setupPacketBatching()
    
    print("[Speed Bypass] ✅ Activated - Speed limit bypassed")
end

function SpeedBypass:Disable()
    if not bypassEnabled then return end
    
    bypassEnabled = false
    
    -- Восстанавливаем хуки
    local mt = getrawmetatable(game)
    if networkHooks[1] then
        setreadonly(mt, false)
        mt.__namecall = networkHooks[1]
        setreadonly(mt, true)
    end
    
    -- Отключаем connections
    for i = 2, #networkHooks do
        if networkHooks[i] then
            networkHooks[i]:Disconnect()
        end
    end
    
    table.clear(networkHooks)
    table.clear(POSITION_HISTORY)
    table.clear(characterCache)
    
    print("[Speed Bypass] ❌ Deactivated")
end

function SpeedBypass:SetMaxDistance(distance)
    MAX_ALLOWED_DISTANCE = distance
    print("[Speed Bypass] Max distance set to:", distance)
end

return SpeedBypass
