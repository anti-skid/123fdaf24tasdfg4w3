-- Society GPT Speed Limit Bypass v1.0
local SpeedBypass = {}
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

-- Конфигурация
local MAX_ALLOWED_DISTANCE = 15 -- Студов за 0.1 секунду
local PACKET_INTERVAL = 0.05 -- Интервал отправки пакетов
local POSITION_HISTORY = {} -- История позиций

-- Глобальные переменные
local bypassEnabled = false
local characterCache = {}
local networkHooks = {}

--[[
  СИСТЕМА ПАКЕТНОЙ ОТПРАВКИ ПОЗИЦИЙ
]]
function setupPacketBatching()
    local lastPacketTime = tick()
    local lastSentPosition = nil
    
    local heartbeat = RunService.Heartbeat:Connect(function()
        if not bypassEnabled or not characterCache.rootPart then return end
        
        local currentTime = tick()
        local rootPart = characterCache.rootPart
        local currentPosition = rootPart.Position
        
        -- Сохраняем историю позиций
        table.insert(POSITION_HISTORY, {
            position = currentPosition,
            time = currentTime
        })
        
        -- Очищаем старую историю (старше 1 секунды)
        for i = #POSITION_HISTORY, 1, -1 do
            if currentTime - POSITION_HISTORY[i].time > 1 then
                table.remove(POSITION_HISTORY, i)
            end
        end
        
        -- Отправляем пакеты с правильным интервалом
        if currentTime - lastPacketTime >= PACKET_INTERVAL then
            if lastSentPosition then
                local distance = (currentPosition - lastSentPosition).Magnitude
                local timeDiff = currentTime - lastPacketTime
                local calculatedSpeed = distance / timeDiff
                
                -- Если скорость превышает лимит - отправляем промежуточные позиции
                if calculatedSpeed > MAX_ALLOWED_DISTANCE / 0.1 then
                    sendIntermediatePositions(lastSentPosition, currentPosition, timeDiff)
                else
                    sendPositionPacket(currentPosition)
                end
            else
                sendPositionPacket(currentPosition)
            end
            
            lastSentPosition = currentPosition
            lastPacketTime = currentTime
        end
    end)
    
    table.insert(networkHooks, heartbeat)
end

--[[
  ОТПРАВКА ПРОМЕЖУТОЧНЫХ ПОЗИЦИЙ
]]
function sendIntermediatePositions(startPos, endPos, totalTime)
    local distance = (endPos - startPos).Magnitude
    local requiredSteps = math.ceil(distance / (MAX_ALLOWED_DISTANCE * 0.8))
    local stepTime = totalTime / requiredSteps
    
    for i = 1, requiredSteps do
        local lerpFactor = i / requiredSteps
        local intermediatePos = startPos:Lerp(endPos, lerpFactor)
        
        task.spawn(function()
            task.wait(stepTime * (i - 1))
            sendPositionPacket(intermediatePos)
        end)
    end
end

