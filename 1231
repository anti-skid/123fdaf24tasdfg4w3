end

--[[
  ПЕРЕХВАТ СЕТЕВЫХ ВЫЗОВОВ
]]
function hookNetworkPackets()
    local mt = getrawmetatable(game)
    local oldNamecall = mt.__namecall
    
    setreadonly(mt, false)
    
    mt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        
        if bypassEnabled and method == "FireServer" then
            local args = {...}
            local remoteName = tostring(self)
            
            -- Перехватываем ремоуты движения
            if isMovementRemote(remoteName) then
                return handleMovementPacket(oldNamecall, self, args)
            end
        end
        
        return oldNamecall(self, ...)
    end)
    
    setreadonly(mt, true)
    table.insert(networkHooks, oldNamecall)
end

--[[
  ПРОВЕРКА ЯВЛЯЕТСЯ ЛИ REMOTE ДВИЖЕНИЕМ
]]
function isMovementRemote(remoteName)
    return remoteName:find("Mouse") or remoteName:find("Input") or 
           remoteName:find("Move") or remoteName:find("Walk") or
           remoteName:find("Position") or remoteName:find("Update")
end

--[[
  ОБРАБОТКА ПАКЕТА ДВИЖЕНИЯ
]]
function handleMovementPacket(originalFunc, remote, args)
    if not characterCache.rootPart then 
        return originalFunc(remote, unpack(args)) 
    end
    
    local currentPos = characterCache.rootPart.Position
    local modifiedArgs = {}
    local hasModified = false
    
    for i, arg in ipairs(args) do
        if typeof(arg) == "Vector3" then
            -- Заменяем на безопасную позицию
            modifiedArgs[i] = getSafePosition(currentPos)
            hasModified = true
        elseif typeof(arg) == "CFrame" then
            modifiedArgs[i] = CFrame.new(getSafePosition(currentPos))
            hasModified = true
        else
            modifiedArgs[i] = arg
        end
    end
    
    if hasModified then
        return originalFunc(remote, unpack(modifiedArgs))
    else
        return originalFunc(remote, unpack(args))
    end
end

--[[
  ПОЛУЧЕНИЕ БЕЗОПАСНОЙ ПОЗИЦИИ
]]
function getSafePosition(targetPos)
    if not lastSentPosition then return targetPos end
    
    local distance = (targetPos - lastSentPosition).Magnitude
    
    if distance <= MAX_ALLOWED_DISTANCE * SAFETY_MARGIN then
        return targetPos
    else
        -- Возвращаем позицию в пределах лимита
        local direction = (targetPos - lastSentPosition).Unit
        return lastSentPosition + direction * (MAX_ALLOWED_DISTANCE * SAFETY_MARGIN)
    end
end

--[[
  ИНИЦИАЛИЗАЦИЯ ПЕРСОНАЖА
]]
function setupCharacterTracking()
    local player = Players.LocalPlayer
    
    local function onCharacterAdded(character)
        local rootPart
        repeat
            rootPart = character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Torso")
            task.wait(0.1)
        until rootPart or not character.Parent
        
        if not rootPart then return end
        
        characterCache.rootPart = rootPart
        characterCache.character = character
        
        -- Сбрасываем историю при новом персонаже
        lastSentPosition = rootPart.Position
        lastSentTime = tick()
        table.clear(positionBuffer)
    end
    
    if player.Character then
        task.spawn(onCharacterAdded, player.Character)
    end
    
    player.CharacterAdded:Connect(onCharacterAdded)
    player.CharacterRemoving:Connect(function()
        characterCache.rootPart = nil
        characterCache.character = nil
        lastSentPosition = nil
        table.clear(positionBuffer)
    end)
end

--[[
  API УПРАВЛЕНИЯ
]]
function SpeedBypass:Enable()
    if bypassEnabled then return end
    
    bypassEnabled = true
    table.clear(positionBuffer)
    
    setupCharacterTracking()
    task.wait(1)
    hookNetworkPackets()
    setupMovementProcessor()
    
    print("[Conservative Speed Bypass] ✅ Activated")
    print("Max distance:", MAX_ALLOWED_DISTANCE)
    print("Safety margin:", SAFETY_MARGIN * 100 .. "%")
end

function SpeedBypass:Disable()
    if not bypassEnabled then return end
    
    bypassEnabled = false
    restoreHooks()
    
    table.clear(positionBuffer)
    table.clear(characterCache)
    lastSentPosition = nil
    
    print("[Conservative Speed Bypass] ❌ Deactivated")
end

function SpeedBypass:SetMaxDistance(distance)
    MAX_ALLOWED_DISTANCE = math.min(distance, 14) -- Максимум 14 для безопасности
    print("[Speed Bypass] Max distance set to:", MAX_ALLOWED_DISTANCE)
end

function SpeedBypass:SetSafetyMargin(margin)
    SAFETY_MARGIN = math.clamp(margin, 0.5, 0.95) -- От 50% до 95%
    print("[Speed Bypass] Safety margin set to:", SAFETY_MARGIN * 100 .. "%")
end

--[[
  ВОССТАНОВЛЕНИЕ ХУКОВ
]]
function restoreHooks()
    local mt = getrawmetatable(game)
    if networkHooks[1] then
        setreadonly(mt, false)
        mt.__namecall = networkHooks[1]
        setreadonly(mt, true)
    end
    
    for i = 2, #networkHooks do
        if networkHooks[i] then
            networkHooks[i]:Disconnect()
        end
    end
    
    table.clear(networkHooks)
end

-- Авто-инициализация
task.spawn(function()
    task.wait(3)
    if not bypassEnabled then
        SpeedBypass:Enable()
    end
end)

return SpeedBypass
