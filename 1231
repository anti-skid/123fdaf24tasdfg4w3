-- Society GPT Anti-Cheat Disabler v1.0
local AntiCheatDisabler = {}

local Players = game:GetService("Players")
local PlayerScripts = Players.LocalPlayer:WaitForChild("PlayerScripts")

--[[
  ОТКЛЮЧЕНИЕ АНТИЧИТ ПРОВЕРОК В СКРИПТЕ :3
]]
function AntiCheatDisabler:DisableAntiCheat()
    local targetScript = PlayerScripts:FindFirstChild(":3")
    
    if not targetScript then
        print("❌ Script ':3' not found in PlayerScripts")
        return false
    end
    
    -- Сохраняем оригинальный код
    local originalSource = targetScript.Source
    
    -- Отключаем античит проверки
    local disabledSource = originalSource:gsub("sendKick%([^%)]+%)", "print(\"Anti-cheat blocked: \" .. ...)")
                   :gsub("game:GetService%(\"Players\"%).LocalPlayer:Kick%([^%)]+%)", "print(\"Kick blocked\")")
                   :gsub("checkCFrameMovement", "function checkCFrameMovement() return false end")
                   :gsub("checkCharacterSizes", "function checkCharacterSizes() return false end")
                   :gsub("startPartMonitoring", "function startPartMonitoring() while true do wait(1) end end")
                   :gsub("startCFrameMonitoring", "function startCFrameMonitoring() while true do wait(1) end end")
                   :gsub("startDesyncMonitoring", "function startDesyncMonitoring() while true do wait(1) end end")
    
    -- Заменяем исходный код
    targetScript.Source = disabledSource
    
    print("✅ Anti-cheat checks disabled in script ':3'")
    return true
end

--[[
  БЫСТРОЕ ОТКЛЮЧЕНИЕ ОСНОВНЫХ ПРОВЕРОК
]]
function AntiCheatDisabler:QuickDisable()
    local targetScript = PlayerScripts:FindFirstChild(":3")
    
    if not targetScript then
        print("❌ Script ':3' not found")
        return false
    end
    
    local source = targetScript.Source
    
    -- Отключаем основные кик-функции
    source = source:gsub("function sendKick%([^%)]*%)[^}]+end", 
        [[function sendKick(reason)
            print("[ANTI-CHEAT BLOCKED] Would kick for:", reason)
            return
        end]])
    
    -- Отключаем проверки движения
    source = source:gsub("function checkCFrameMovement%([^%)]*%)[^}]+end",
        [[function checkCFrameMovement()
            return false
        end]])
    
    -- Отключаем проверки размера
    source = source:gsub("function checkCharacterSizes%([^%)]*%)[^}]+end", 
        [[function checkCharacterSizes()
            return false
        end]])
    
    targetScript.Source = source
    print("✅ Quick anti-cheat disable completed")
    return true
end

--[[
  ПОЛНОЕ ОТКЛЮЧЕНИЕ ВСЕХ ПРОВЕРОК
]]
function AntiCheatDisabler:FullDisable()
    local targetScript = PlayerScripts:FindFirstChild(":3")
    
    if not targetScript then
        print("❌ Script ':3' not found")
        return false
    end
    
    local source = targetScript.Source
    
    -- 1. Отключаем все кик-функции
    source = source:gsub("sendKick%([^%)]+%)", "print(\"[BLOCKED] \" .. ...)")
    
    -- 2. Отключаем проверки скорости
    source = source:gsub("SPEED_THRESHOLD = %d+", "SPEED_THRESHOLD = 999999")
    source = source:gsub("MAX_ALLOWED_DISTANCE = %d+", "MAX_ALLOWED_DISTANCE = 999999")
    
    -- 3. Отключаем мониторинги
    local monitoringFunctions = {
        "checkCFrameMovement", "checkCharacterSizes", "startPartMonitoring",
        "startSizeMonitoring", "startCFrameMonitoring", "startDesyncMonitoring"
    }
    
    for _, funcName in ipairs(monitoringFunctions) do
        source = source:gsub("function " .. funcName .. "%([^%)]*%)[^}]+end",
            "function " .. funcName .. "() while true do wait(10) end end")
    end
    
    -- 4. Отключаем проверки Walkspeed
    source = source:gsub("Config%.WalkspeedProtect%.enabled = true", "Config.WalkspeedProtect.enabled = false")
    source = source:gsub("Config%.WalkspeedProtect%.maxWalkSpeed = %d+", "Config.WalkspeedProtect.maxWalkSpeed = 999")
    
    -- 5. Отключаем проверки Hitbox
    source = source:gsub("Config%.HitboxProtect%.enabled = true", "Config.HitboxProtect.enabled = false")
    
    -- 6. Отключаем проверки Fly
    source = source:gsub("Config%.FlyProtect%.enabled = true", "Config.FlyProtect.enabled = false")
    
    -- 7. Отключаем проверки NoClip
    source = source:gsub("Config%.NoClipProtect%.enabled = true", "Config.NoClipProtect.enabled = false")
    
    targetScript.Source = source
    print("✅ Full anti-cheat disable completed")
    return true
end

--[[
  АВТОМАТИЧЕСКОЕ ОТКЛЮЧЕНИЕ
]]
function AntiCheatDisabler:AutoDisable()
    local targetScript = PlayerScripts:FindFirstChild(":3")
    
    if not targetScript then
        print("❌ Script ':3' not found - nothing to disable")
        return false
    end
    
    print("🔍 Society GPT Anti-Cheat Disabler - Analyzing script...")
    
    -- Применяем полное отключение
    local success = self:FullDisable()
    
    if success then
        print("🎉 SUCCESS: All anti-cheat checks disabled!")
        print("✅ Script ':3' remains functional without restrictions")
    else
        print("❌ FAILED: Could not disable anti-cheat")
    end
    
    return success
end

--[[
  ПРОВЕРКА СТАТУСА
]]
function AntiCheatDisabler:GetStatus()
    local targetScript = PlayerScripts:FindFirstChild(":3")
    
    if not targetScript then
        return "NO_SCRIPT"
    end
    
    local source = targetScript.Source
    
    -- Проверяем наличие активных античит проверок
    local hasKick = source:find("sendKick") ~= nil
    local hasSpeedCheck = source:find("SPEED_THRESHOLD") ~= nil
    local hasCFrameCheck = source:find("checkCFrameMovement") ~= nil
    
    if hasKick or hasSpeedCheck or hasCFrameCheck then
        return "ANTICHEAT_ACTIVE"
    else
        return "ANTICHEAT_DISABLED"
    end
end

-- Автоматический запуск
task.spawn(function()
    task.wait(3) -- Ждем загрузки скрипта :3
    local status = AntiCheatDisabler:GetStatus()
    
    if status == "ANTICHEAT_ACTIVE" then
        print("🛡️ Anti-cheat detected - Disabling...")
        AntiCheatDisabler:AutoDisable()
    elseif status == "ANTICHEAT_DISABLED" then
        print("✅ Anti-cheat already disabled")
    else
        print("⚠️ Script ':3' not found")
    end
end)

return AntiCheatDisabler
