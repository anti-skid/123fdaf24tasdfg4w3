-- Society GPT Conservative Speed Bypass v1.1
local SpeedBypass = {}
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

-- Конфигурация (консервативные значения)
local MAX_ALLOWED_DISTANCE = 14 -- 14 вместо 15 для запаса
local PACKET_INTERVAL = 0.0001 -- Чаще чем 0.1s
local SAFETY_MARGIN = 0.9 -- 90% от лимита для надежности

-- Глобальные переменные
local bypassEnabled = false
local characterCache = {}
local networkHooks = {}
local positionBuffer = {}
local lastSentPosition = nil
local lastSentTime = 0

--[[
  ОСНОВНОЙ ЦИКЛ ОБРАБОТКИ ДВИЖЕНИЯ
]]
function setupMovementProcessor()
    local heartbeat = RunService.Heartbeat:Connect(function()
        if not bypassEnabled or not characterCache.rootPart then return end
        
        local currentTime = tick()
        local rootPart = characterCache.rootPart
        local currentPosition = rootPart.Position
        
        -- Добавляем позицию в буфер
        table.insert(positionBuffer, {
            position = currentPosition,
            time = currentTime
        })
        
        -- Очищаем старый буфер (сохраняем только последние 0.3s)
        while #positionBuffer > 0 and currentTime - positionBuffer[1].time > 0.3 do
            table.remove(positionBuffer, 1)
        end
        
        -- Отправляем пакет если пришло время
        if currentTime - lastSentTime >= PACKET_INTERVAL then
            processAndSendPosition(currentPosition, currentTime)
        end
    end)
    
    table.insert(networkHooks, heartbeat)
end

--[[
  ОБРАБОТКА И ОТПРАВКА ПОЗИЦИИ
]]
function processAndSendPosition(currentPos, currentTime)
    if not lastSentPosition then
        -- Первая отправка
        sendNetworkPosition(currentPos)
        lastSentPosition = currentPos
        lastSentTime = currentTime
        return
    end
    
    local rawDistance = (currentPos - lastSentPosition).Magnitude
    local timeDiff = currentTime - lastSentTime
    
    -- Рассчитываем реальную скорость
    local actualSpeed = rawDistance / timeDiff
    local maxAllowedSpeed = (MAX_ALLOWED_DISTANCE * SAFETY_MARGIN) / 0.1
    
    if actualSpeed <= maxAllowedSpeed then
        -- Скорость в пределах - отправляем как есть
        sendNetworkPosition(currentPos)
        lastSentPosition = currentPos
        lastSentTime = currentTime
    else
        -- Скорость превышена - отправляем промежуточные позиции
        sendIntermediatePositions(lastSentPosition, currentPos, timeDiff)
        lastSentPosition = currentPos
        lastSentTime = currentTime
    end
end

--[[
  ОТПРАВКА ПРОМЕЖУТОЧНЫХ ПОЗИЦИЙ
]]
function sendIntermediatePositions(startPos, endPos, totalTime)
    local totalDistance = (endPos - startPos).Magnitude
    
    -- Рассчитываем необходимое количество шагов
    local maxStepDistance = MAX_ALLOWED_DISTANCE * SAFETY_MARGIN
    local requiredSteps = math.max(2, math.ceil(totalDistance / maxStepDistance))
    local stepTime = totalTime / requiredSteps
    
    for step = 1, requiredSteps do
        local progress = step / requiredSteps
        local intermediatePos = startPos:Lerp(endPos, progress)
        
        -- Отправляем с задержкой для имитации реального движения
        task.delay(stepTime * (step - 1), function()
            if bypassEnabled then
                sendNetworkPosition(intermediatePos)
            end
        end)
    end
end

--[[
  ОТПРАВКА ПОЗИЦИИ В СЕТЬ
]]
function sendNetworkPosition(position)
