-- Society GPT Speed Compliance v2.0
local SpeedCompliance = {}
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

-- СУПЕР КОНСЕРВАТИВНЫЕ НАСТРОЙКИ
local MAX_STUDS_PER_100MS = 12 -- ОЧЕНЬ безопасное значение
local PACKET_INTERVAL = 0.1 -- Точный интервал античита
local HUMAN_LIKE_ACCELERATION = true -- Имитация человеческого движения

-- Глобальные переменные
local enabled = false
local characterCache = {}
local hooks = {}
local movementHistory = {}
local lastLegitimatePosition = nil
local lastPacketTime = 0
local isSendingPacket = false

--[[
  ФИЗИЧЕСКИ КОРРЕКТНОЕ ДВИЖЕНИЕ
]]
function setupPhysicsCompliantMovement()
    local heartbeat = RunService.Heartbeat:Connect(function()
        if not enabled or not characterCache.rootPart or isSendingPacket then return end
        
        local currentTime = tick()
        local rootPart = characterCache.rootPart
        local currentPos = rootPart.Position
        
        -- Инициализация
        if not lastLegitimatePosition then
            lastLegitimatePosition = currentPos
            lastPacketTime = currentTime
            return
        end
        
        -- Сохраняем историю движения
        table.insert(movementHistory, {
            position = currentPos,
            time = currentTime,
            velocity = rootPart.Velocity
        })
        
        -- Ограничиваем историю (последние 2 секунды)
        while #movementHistory > 0 and currentTime - movementHistory[1].time > 2 do
            table.remove(movementHistory, 1)
        end
        
        -- Отправляем пакет строго по интервалу античита
        if currentTime - lastPacketTime >= PACKET_INTERVAL then
            sendCompliantPosition(currentPos, currentTime)
        end
    end)
    
    table.insert(hooks, heartbeat)
end

--[[
  ОТПРАВКА СООТВЕТСТВУЮЩЕЙ ПОЗИЦИИ
]]
function sendCompliantPosition(currentPos, currentTime)
    isSendingPacket = true
    
    local timeDiff = currentTime - lastPacketTime
    local rawDistance = (currentPos - lastLegitimatePosition).Magnitude
    
    -- РАСЧЕТ МАКСИМАЛЬНОГО РАССТОЯНИЯ С УЧЕТОМ ФИЗИКИ
    local maxPossibleDistance = calculateMaxPossibleDistance(timeDiff)
    
    if rawDistance <= maxPossibleDistance then
        -- Движение в пределах возможного - отправляем как есть
        sendToServer(currentPos)
        lastLegitimatePosition = currentPos
    else
        -- Движение невозможно - отправляем ближайшую валидную позицию
        local compliantPos = getCompliantPosition(currentPos, maxPossibleDistance)
        sendToServer(compliantPos)
        lastLegitimatePosition = compliantPos
    end
    
    lastPacketTime = currentTime
    isSendingPacket = false
end

--[[
  РАСЧЕТ МАКСИМАЛЬНО ВОЗМОЖНОГО РАССТОЯНИЯ
]]
function calculateMaxPossibleDistance(timeDiff)
    local baseDistance = MAX_STUDS_PER_100MS * (timeDiff / 0.1)
    
    -- Учет ускорения и замедления (человеческое движение)
    if HUMAN_LIKE_ACCELERATION and #movementHistory >= 3 then
        local recentSpeed = calculateRecentSpeed()
        local maxHumanSpeed = 16 * 0.1 -- 16 studs/100ms = ~160 studs/s
        
        if recentSpeed > maxHumanSpeed then
            baseDistance = baseDistance * 0.7 -- Замедление если слишком быстро
        end
    end
    
    return math.min(baseDistance, MAX_STUDS_PER_100MS * 1.1)
end

--[[
  РАСЧЕТ ТЕКУЩЕЙ СКОРОСТИ
]]
function calculateRecentSpeed()
    if #movementHistory < 2 then return 0 end
    
    local totalDistance = 0
    local totalTime = 0
    
    for i = 2, #movementHistory do
        local dist = (movementHistory[i].position - movementHistory[i-1].position).Magnitude
        local time = movementHistory[i].time - movementHistory[i-1].time
        
        totalDistance = totalDistance + dist
        totalTime = totalTime + time
    end
    
    return totalTime > 0 and (totalDistance / totalTime) or 0
end

--[[
  ПОЛУЧЕНИЕ СООТВЕТСТВУЮЩЕЙ ПОЗИЦИИ
]]
function getCompliantPosition(targetPos, maxDistance)
    local direction = (targetPos - lastLegitimatePosition).Unit
    local compliantPos = lastLegitimatePosition + direction * maxDistance * 0.95
    
    -- Добавляем небольшую случайность для естественности
    local randomOffset = Vector3.new(
        math.random(-0.2, 0.2),
        math.random(-0.1, 0.1),
        math.random(-0.2, 0.2)
    )
    
    return compliantPos + randomOffset
end

--[[
  ПЕРЕХВАТ ВСЕХ СЕТЕВЫХ ВЫЗОВОВ
]]
function hookAllNetworkCommunication()
    local mt = getrawmetatable(game)
    local oldNamecall = mt.__namecall
    local oldIndex = mt.__index
    
    setreadonly(mt, false)
    
    -- Hook __namecall для RemoteEvents
    mt.__namecall = newcclosure(function(self, ...)
        if enabled and getnamecallmethod() == "FireServer" then
            local args = {...}
            if shouldInterceptRemote(tostring(self)) then
                return handleInterceptedPacket(oldNamecall, self, args)
            end
        end
        return oldNamecall(self, ...)
    end)
    
    -- Hook __index для чтения позиции
    mt.__index = newcclosure(function(self, key)
        if enabled and not checkcaller() then
            if typeof(self) == "Instance" and self:IsA("BasePart") then
                if (key == "Position" or key == "CFrame") and isPlayerPart(self) then
                    return provideCompliantValue(self, key)
                end
            end
        end
        return oldIndex(self, key)
    end)
    
    setreadonly(mt, true)
    
    table.insert(hooks, {namecall = oldNamecall, index = oldIndex})
end

--[[
  ОБРАБОТКА ПЕРЕХВАЧЕННЫХ ПАКЕТОВ
]]
function handleInterceptedPacket(original, remote, args)
    if not characterCache.rootPart then 
        return original(remote, unpack(args)) 
    end
    
    local currentPos = characterCache.rootPart.Position
    local modifiedArgs = {}
    
    for i, arg in ipairs(args) do
        if typeof(arg) == "Vector3" then
            modifiedArgs[i] = getNetworkPosition(currentPos)
        elseif typeof(arg) == "CFrame" then
            modifiedArgs[i] = CFrame.new(getNetworkPosition(currentPos))
        else
            modifiedArgs[i] = arg
        end
    end
    
    return original(remote, unpack(modifiedArgs))
end

--[[
  ПОЗИЦИЯ ДЛЯ СЕТИ
]]
function getNetworkPosition(realPos)
    if not lastLegitimatePosition then return realPos end
    
    local distance = (realPos - lastLegitimatePosition).Magnitude
    if distance <= MAX_STUDS_PER_100MS then
        return realPos
    else
        return lastLegitimatePosition
    end
end

--[[
  ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ
]]
function shouldInterceptRemote(remoteName)
    return remoteName:find("Mouse") or remoteName:find("Input") or 
           remoteName:find("Move") or remoteName:find("Walk") or
           remoteName:find("Position") or remoteName:find("Heart") or
           remoteName:find("Update")
end

function isPlayerPart(part)
    return part:IsDescendantOf(characterCache.character or Players.LocalPlayer)
end

function provideCompliantValue(part, key)
    if key == "Position" then
        return lastLegitimatePosition or part.Position
    else
        return CFrame.new(lastLegitimatePosition or part.Position)
    end
end

function sendToServer(position)
