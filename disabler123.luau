urn end\n\t\n\t\n\tlocal durationValue = player:FindFirstChild(\"HitchamsDuration\")\n\tlocal hitchamsDuration = durationValue and durationValue.Value or 3.0\n\t\n\t\n\tlocal characterClone = Instance.new(\"Model\")\n\tcharacterClone.Name = \"\" \n\tcharacterClone.Parent = workspace\n\t\n\t\n\ttable.insert(hitchamsClones, characterClone)\n\t\n\t\n\tfor _, child in ipairs(hitModel:GetChildren()) do\n\t\tif child:IsA(\"BasePart\") and child.Name ~= \"HumanoidRootPart\" then\n\t\t\t\n\t\t\tlocal clonedPart = child:Clone()\n\t\t\tclonedPart.Parent = characterClone\n\t\t\t\n\t\t\t\n\t\t\tfor _, descendant in ipairs(clonedPart:GetDescendants()) do\n\t\t\t\tif descendant:IsA(\"Attachment\") or descendant:IsA(\"Motor6D\") or descendant:IsA(\"Weld\") or descendant:IsA(\"WeldConstraint\") then\n\t\t\t\t\tdescendant:Destroy()\n\t\t\t\tend\n\t\t\tend\n\t\t\t\n\t\t\t\n\t\t\tclonedPart.BrickColor = BrickColor.new(\"White\")\n\t\t\tclonedPart.Material = Enum.Material.ForceField\n\t\t\tclonedPart.Transparency = 0\n\t\t\tclonedPart.CanCollide = false\n\t\t\tclonedPart.Anchored = true\n\t\telseif child:IsA(\"Accessory\") then\n\t\t\t\n\t\t\tlocal clonedAccessory = child:Clone()\n\t\t\tclonedAccessory.Parent = characterClone\n\t\t\t\n\t\t\t\n\t\t\tfor _, descendant in ipairs(clonedAccessory:GetDescendants()) do\n\t\t\t\tif descendant:IsA(\"Attachment\") or descendant:IsA(\"Motor6D\") or descendant:IsA(\"Weld\") or descendant:IsA(\"WeldConstraint\") then\n\t\t\t\t\tdescendant:Destroy()\n\t\t\t\tend\n\t\t\tend\n\t\t\t\n\t\t\t\n\t\t\tfor _, part in ipairs(clonedAccessory:GetDescendants()) do\n\t\t\t\tif part:IsA(\"BasePart\") then\n\t\t\t\t\t\n\t\t\t\t\tpart.BrickColor = BrickColor.new(\"White\")\n\t\t\t\t\tpart.Material = Enum.Material.ForceField\n\t\t\t\t\tpart.Transparency = 0\n\t\t\t\t\tpart.CanCollide = false\n\t\t\t\t\tpart.Anchored = true\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\n\t\n\t\n\tlocal highlight = Instance.new(\"Highlight\")\n\thighlight.OutlineColor = Color3.fromRGB(255, 255, 255)\n\thighlight.FillColor = Color3.fromRGB(255, 255, 255)\n\thighlight.FillTransparency = 0.7\n\thighlight.Parent = characterClone\n\t\n\t\n\tlocal customHumanoid = Instance.new(\"Humanoid\")\n\tcustomHumanoid.Parent = characterClone\n\tcustomHumanoid.PlatformStand = true\n\t\n\t\n\tpcall(function()\n\t\tcustomHumanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)\n\t\tcustomHumanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)\n\t\tcustomHumanoid:SetStateEnabled(Enum.HumanoidStateType.Flying, false)\n\t\tcustomHumanoid:SetStateEnabled(Enum.HumanoidStateType.Freefall, false)\n\t\tcustomHumanoid:SetStateEnabled(Enum.HumanoidStateType.GettingUp, false)\n\t\tcustomHumanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)\n\t\tcustomHumanoid:SetStateEnabled(Enum.HumanoidStateType.Landed, false)\n\t\tcustomHumanoid:SetStateEnabled(Enum.HumanoidStateType.Physics, false)\n\t\tcustomHumanoid:SetStateEnabled(Enum.HumanoidStateType.PlatformStanding, false)\n\t\tcustomHumanoid:SetStateEnabled(Enum.HumanoidStateType.Running, false)\n\t\tcustomHumanoid:SetStateEnabled(Enum.HumanoidStateType.RunningNoPhysics, false)\n\t\tcustomHumanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, false)\n\t\tcustomHumanoid:SetStateEnabled(Enum.HumanoidStateType.Swimming, false)\n\t\tcustomHumanoid:SetStateEnabled(Enum.HumanoidStateType.Climbing, false)\n\tend)\n\t\n\t\n\tlocal cachedParts = {}\n\tfor _, part in ipairs(characterClone:GetDescendants()) do\n\t\tif part:IsA(\"BasePart\") then\n\t\t\ttable.insert(cachedParts, part)\n\t\tend\n\tend\n\tlocal cachedHighlight = characterClone:FindFirstChildOfClass(\"Highlight\")\n\t\n\t\n\ttask.spawn(function()\n\t\tlocal fadeSteps = 20\n\t\tlocal stepTime = hitchamsDuration / fadeSteps\n\t\t\n\t\tfor i = 1, fadeSteps do\n\t\t\tlocal transparency = i / fadeSteps\n\t\t\tfor _, part in ipairs(cachedParts) do\n\t\t\t\tif part and part.Parent then\n\t\t\t\t\tpart.Transparency = transparency\n\t\t\t\tend\n\t\t\tend\n\t\t\t\n\t\t\tif cachedHighlight and cachedHighlight.Parent then\n\t\t\t\tcachedHighlight.FillTransparency = 0.7 + (transparency * 0.3)\n\t\t\tend\n\t\t\ttask.wait(stepTime)\n\t\tend\n\t\t\n\t\t\n\t\tfor i = #hitchamsClones, 1, -1 do\n\t\t\tif hitchamsClones[i] == characterClone then\n\t\t\t\ttable.remove(hitchamsClones, i)\n\t\t\t\tbreak\n\t\t\tend\n\t\tend\n\t\t\n\t\tcharacterClone:Destroy()\n\tend)\nend\n\n\nlocal cachedBlacklist = {}\nlocal lastBlacklistUpdate = 0\nlocal BLACKLIST_CACHE_TIME = 0.1 \n\n\nlocal cachedRaycastParams = nil\nfunction getCachedRaycastParams()\n\tif not cachedRaycastParams then\n\t\tcachedRaycastParams = RaycastParams.new()\n\t\tcachedRaycastParams.FilterType = Enum.RaycastFilterType.Exclude\n\tend\n\tcachedRaycastParams.FilterDescendantsInstances = getCachedBlacklist()\n\treturn cachedRaycastParams\nend\n\n\nlocal penetrableList = {}\nlocal penetrableSet = {}\n\n\nlocal transientBlacklistParts = {}\nfunction addTransientToBlacklist(part)\n\tif part then\n\t\ttable.insert(transientBlacklistParts, part)\n\tend\nend\n\nlocal function addPenetrable(inst)\n\tif inst and inst:IsA(\"BasePart\") and inst.Name == \"Penetrable\" and not penetrableSet[inst] then\n\t\tpenetrableSet[inst] = true\n\t\ttable.insert(penetrableList, inst)\n\tend\nend\n\nlocal function removePenetrable(inst)\n\tif inst and penetrableSet[inst] then\n\t\tpenetrableSet[inst] = nil\n\t\tfor i = #penetrableList, 1, -1 do\n\t\t\tif penetrableList[i] == inst then\n\t\t\t\ttable.remove(penetrableList, i)\n\t\t\t\tbreak\n\t\t\tend\n\t\tend\n\tend\nend\n\n\nlocal function seedPenetrables(container)\n\tfor _, child in ipairs(container:GetChildren()) do\n\t\taddPenetrable(child)\n\t\tseedPenetrables(child)\n\tend\nend\n\nseedPenetrables(workspace)\n\nworkspace.DescendantAdded:Connect(function(inst)\n\taddPenetrable(inst)\nend)\n\nworkspace.DescendantRemoving:Connect(function(inst)\n\tremovePenetrable(inst)\nend)\n\nfunction getPenetrableWhitelist()\n\treturn penetrableList\nend\n\nfunction getHitchamsBlacklist()\n\tlocal blacklist = {}\n\tfor _, clone in ipairs(hitchamsClones) do\n\t\tif clone and clone.Parent then\n\t\t\t\n\t\t\ttable.insert(blacklist, clone)\n\t\tend\n\tend\n\treturn blacklist\nend\n\nfunction getCachedBlacklist()\n\tlocal now = tick()\n\tif now - lastBlacklistUpdate > BLACKLIST_CACHE_TIME then\n\t\tcachedBlacklist = {}\n\t\tif player.Character then\n\t\t\ttable.insert(cachedBlacklist, player.Character)\n\t\tend\n\t\tlocal tmpClonesFolder = workspace:FindFirstChild(\"tmp_clones\")\n\t\tif tmpClonesFolder then\n\t\t\ttable.insert(cachedBlacklist, tmpClonesFolder)\n\t\tend\n\t\tlocal hitchamsBlacklist = getHitchamsBlacklist()\n\t\tfor _, item in ipairs(hitchamsBlacklist) do\n\t\t\ttable.insert(cachedBlacklist, item)\n\t\tend\n\n\t\t\n\t\tfor _, plr in ipairs(Players:GetPlayers()) do\n\t\t\tlocal char = plr.Character\n\t\t\tif char then\n\t\t\t\tfor _, child in ipairs(char:GetChildren()) do\n\t\t\t\t\tif child:IsA(\"Tool\") then\n\t\t\t\t\t\ttable.insert(cachedBlacklist, child)\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\n\t\t\n\t\tfor _, plr in ipairs(Players:GetPlayers()) do\n\t\t\tif plr ~= player then\n\t\t\t\tlocal char = plr.Character\n\t\t\t\tif char then\n\t\t\t\t\tfor _, child in ipairs(char:GetChildren()) do\n\t\t\t\t\t\tif child:IsA(\"Accessory\") then\n\t\t\t\t\t\t\ttable.insert(cachedBlacklist, child)\n\t\t\t\t\t\tend\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\t\t\n\t\t\n\t\tfor i = #transientBlacklistParts, 1, -1 do\n\t\t\tlocal p = transientBlacklistParts[i]\n\t\t\tif p and p.Parent then\n\t\t\t\ttable.insert(cachedBlacklist, p)\n\t\t\telse\n\t\t\t\ttable.remove(transientBlacklistParts, i)\n\t\t\tend\n\t\tend\n\t\t\n\t\tlastBlacklistUpdate = now\n\tend\n\treturn cachedBlacklist\nend\n\nfunction getExitPoint(part, entryPos, direction)\n\tlocal size = part.Size\n\tlocal cf = part.CFrame:Inverse() * CFrame.new(entryPos)\n\tlocal localEntry = cf.Position\n\tlocal localDir = part.CFrame:VectorToObjectSpace(direction)\n\tlocal tMax = math.huge\n\tlocal axes = {\"X\", \"Y\", \"Z\"}\n\tfor _, axis in ipairs(axes) do\n\t\tif math.abs(localDir[axis]) > 1e-4 then\n\t\t\tlocal half = size[axis]/2\n\t\t\tlocal t1 = ( half - localEntry[axis]) / localDir[axis]\n\t\t\tlocal t2 = (-half - localEntry[axis]) / localDir[axis]\n\t\t\tlocal t = math.max(t1, t2)\n\t\t\tif t > 0 and t < tMax then\n\t\t\t\ttMax = t\n\t\t\tend\n\t\tend\n\tend\n\tlocal localExit = localEntry + localDir * tMax\n\tlocal worldExit = part.CFrame:PointToWorldSpace(localExit)\n\treturn worldExit\nend\n\nfunction checkPenetrableAlongRay(origin, direction, maxDistance, _)\n\tlocal wl = getPenetrableWhitelist()\n\tif #wl == 0 then return nil end\n\tlocal params = RaycastParams.new()\n\tparams.FilterType = Enum.RaycastFilterType.Include\n\tparams.FilterDescendantsInstances = wl\n\tlocal result = workspace:Raycast(origin, direction * maxDistance, params)\n\tif result and result.Instance and result.Instance.Name == \"Penetrable\" then\n\t\treturn result, result.Position, result.Normal\n\tend\n\treturn nil\nend\n\nfunction getBodyPartName(hitPart)\n\tlocal r6BodyParts = {\n\t\t[\"Head\"] = \"Head\",\n\t\t[\"HumanoidRootPart\"] = \"HumanoidRootPart\",\n\t\t[\"LeftArm\"] = \"Left Arm\",\n\t\t[\"LeftLeg\"] = \"Left Leg\",\n\t\t[\"RightArm\"] = \"Right Arm\",\n\t\t[\"RightLeg\"] = \"Right Leg\",\n\t\t[\"Torso\"] = \"Torso\"\n\t}\n\treturn r6BodyParts[hitPart.Name] or \"Default\"\nend\n\n\nlocal function calculateClientDamage(distance, passedThroughPenetrable, hitPartName)\n\tlocal numericDistance = tonumber(distance) or 0\n\tlocal penetrated = (passedThroughPenetrable == true) or (tostring(passedThroughPenetrable) == \"true\")\n\t\n\tif numericDistance > DmgConfig.DistanceMaxRange then\n\t\treturn 0\n\tend\n\n\tlocal hitData = DmgConfig.DamageTable[hitPartName] or DmgConfig.DamageTable[\"Default\"]\n\tlocal damage = hitData.base * hitData.multiplier\n\tlocal damageReduction = 0\n\t\n\tif numericDistance <= 100 then\n\t\tdamageReduction = 0\n\telseif numericDistance <= 150 then\n\t\tdamageReduction = 0.15\n\telseif numericDistance <= 160 then\n\t\tdamageReduction = 0.25\n\telse\n\t\tdamageReduction = 0.45\n\tend\n\t\n\tdamage = damage * (1 - damageReduction)\n\t\n\tif penetrated then\n\t\tdamage = damage * DmgConfig.DamageMultiplierAfterWall\n\tend\n\t\n\t\n\tlocal randomFactor = 0.97 + (math.random() * 0.06)\n\tdamage = damage * randomFactor\n\t\n\treturn math.floor(damage)\nend\n\nlocal function calculateClientDamageWithArmor(damage, armorValue, bodyPart)\n\tlocal hitData = DmgConfig.DamageTable[bodyPart] or DmgConfig.DamageTable[\"Default\"]\n\tlocal armorPenetration = hitData.armorPenetration\n\tlocal armorDamage = 0\n\tlocal healthDamage = damage\n\tlocal armorLoss = 0\n\t\n\tif armorValue > 0 then\n\t\tarmorDamage = math.min(armorValue, damage * DmgConfig.ArmorAbsorptionRate * armorPenetration)\n\t\tarmorLoss = math.min(armorValue, damage * DmgConfig.ArmorLossRate)\n\t\thealthDamage = damage * (1 - (DmgConfig.ArmorAbsorptionRate * armorPenetration))\n\tend\n\t\n\treturn math.floor(damage), math.floor(armorDamage), math.floor(healthDamage), math.floor(armorLoss)\nend\n\nfunction isPositionInsidePart(position)\n\tlocal overlapParams = OverlapParams.new()\n\toverlapParams.FilterType = Enum.RaycastFilterType.Exclude\n\tlocal exclude = {}\n\tif player.Character then table.insert(exclude, player.Character) end\n\toverlapParams.FilterDescendantsInstances = exclude\n\tlocal radius = 0.25\n\tlocal parts = workspace:GetPartBoundsInRadius(position, radius, overlapParams)\n\tfor _, part in ipairs(parts) do\n\t\tif part:IsA(\"BasePart\") and part.CanCollide and part.Name ~= \"Terrain\" then\n\t\t\tlocal p = part\n\t\t\tlocal inTool = false\n\t\t\twhile p do\n\t\t\t\tif p:IsA(\"Tool\") then inTool = true break end\n\t\t\t\tp = p.Parent\n\t\t\tend\n\t\t\tif not inTool then return true end\n\t\tend\n\tend\n\treturn false\nend\n\nfunction reload()\n\tif isActTriggered() then return end\n\tif isReloading then return end\n\tlocal currentTool = findSSGTool()\n\tif not currentTool then return end\n\tlocal ammoValue = currentTool:FindFirstChild(\"Ammo\")\n\tif not ammoValue or not ammoValue:IsA(\"IntValue\") then return end\n\t\n\tisReloading = true\n\tcanShoot = false\n\t\n\tlocal config = Instance.new(\"Configuration\")\n\tconfig.Name = \"Reload\"\n\tconfig.Parent = currentTool\n\t\n\tgame.ReplicatedStorage.Reload:FireServer()\n\t\n\ttask.wait(RELOAD_TIME)\n\tisReloading = false\n\tcanShoot = true\nend\n\n\nlocal function canFireShot()\n\tif isActTriggered() then\n\t\treturn false\n\tend\n\tif not canShoot then\n\t\treturn false\n\tend\n\tlocal character = player.Character\n\tif character and character:FindFirstChild(\"ForceField\") then\n\t\treturn\n\tend\n\n\tlocal humanoid = character and character:FindFirstChildOfClass(\"Humanoid\")\n\tif humanoid and humanoid:GetState() == Enum.HumanoidStateType.Dead then\n\t\treturn\n\tend\n\tif (tick() - lastShotTime < SHOT_COOLDOWN) then\n\t\treturn false\n\tend\n\n\tif isReloading then\n\t\treturn false\n\tend\n\n\tlocal currentTool = findSSGTool()\n\tif not currentTool then return false end\n\tlocal ammoValue = currentTool:FindFirstChild(\"Ammo\")\n\tif not ammoValue or not ammoValue:IsA(\"IntValue\") or ammoValue.Value <= 0 then\n\t\treturn false\n\tend\n\n\treturn true\nend\n\n\nlocal function checkPlayerHit(rayOrigin, direction)\n\tlocal character = player.Character\n\tif character and character:FindFirstChild(\"ForceField\") then\n\t\treturn false\n\tend\n\n\tlocal humanoid = character and character:FindFirstChildOfClass(\"Humanoid\")\n\tif humanoid and humanoid:GetState() == Enum.HumanoidStateType.Dead then\n\t\treturn false\n\tend\n\t\n\tlocal bulletRayParams = RaycastParams.new()\n\tbulletRayParams.FilterType = Enum.RaycastFilterType.Exclude\n\tlocal exclude = {}\n\tfor _, inst in ipairs(getCachedBlacklist()) do table.insert(exclude, inst) end\n\tfor _, pen in ipairs(getPenetrableWhitelist()) do table.insert(exclude, pen) end\n\tbulletRayParams.FilterDescendantsInstances = exclude\n\n\t\n\t\n\tlocal bulletRayResult = workspace:Raycast(rayOrigin, direction * 200, bulletRayParams)\n\n\tif bulletRayResult then\n\t\tlocal hitModel = bulletRayResult.Instance:FindFirstAncestorOfClass(\"Model\")\n\t\tif hitModel and hitModel:FindFirstChildOfClass(\"Humanoid\") then\n\t\t\t\n\t\t\tlocal distance = (bulletRayResult.Position - rayOrigin).Magnitude\n\t\t\tif distance <= 200 then\n\t\t\t\tlocal forceField = hitModel:FindFirstChild(\"ForceField\")\n\t\t\t\tlocal targetHumanoid = hitModel:FindFirstChildOfClass(\"Humanoid\")\n\t\t\t\tlocal isTargetDead = targetHumanoid and targetHumanoid:GetState() == Enum.HumanoidStateType.Dead\n\t\t\t\tif forceField or isTargetDead then\n\t\t\t\t\tlocal alternativeTarget = findAlternativeTarget(rayOrigin, direction, bulletBlacklist)\n\t\t\t\t\tif alternativeTarget then\n\t\t\t\t\t\treturn true, alternativeTarget.Position, alternativeTarget.Model, alternativeTarget.Part\n\t\t\t\t\tend\n\t\t\t\t\treturn false\n\t\t\t\telse\n\t\t\t\t\treturn true, bulletRayResult.Position, hitModel, bulletRayResult.Instance\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\n\treturn false\nend\n\n\nlocal function findAlternativeTarget(rayOrigin, direction, blacklist)\n\tlocal maxDistance = 200\n\tlocal currentDistance = 0\n\tlocal stepSize = 10\n\n\twhile currentDistance < maxDistance do\n\t\tlocal checkPos = rayOrigin + direction * currentDistance\n\t\tlocal rayParams = RaycastParams.new()\n\t\trayParams.FilterDescendantsInstances = blacklist\n\t\trayParams.FilterType = Enum.RaycastFilterType.Exclude\n\n\t\tlocal result = workspace:Raycast(checkPos, direction * stepSize, rayParams)\n\t\tif result then\n\t\t\tlocal hitModel = result.Instance:FindFirstAncestorOfClass(\"Model\")\n\t\t\tif hitModel and hitModel:FindFirstChildOfClass(\"Humanoid\") then\n\t\t\t\t\n\t\t\t\tlocal forceField = hitModel:FindFirstChild(\"ForceField\")\n\t\t\t\tif not forceField then\n\t\t\t\t\treturn {\n\t\t\t\t\t\tPosition = result.Position,\n\t\t\t\t\t\tModel = hitModel,\n\t\t\t\t\t\tPart = result.Instance\n\t\t\t\t\t}\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\n\t\tcurrentDistance = currentDistance + stepSize\n\tend\n\n\treturn nil\nend\n\n\n\nlocal function checkTargetPositionSync(hitModel)\n\tif not hitModel then return true end\n\t\n\tlocal targetPlayer = Players:GetPlayerFromCharacter(hitModel)\n\tif not targetPlayer then return true end\n\t\n\t\n\tlocal posAttribute = targetPlayer:GetAttribute(\"Pos\")\n\tif not posAttribute or typeof(posAttribute) ~= \"Vector3\" then\n\t\treturn true \n\tend\n\t\n\t\n\tlocal hrp = hitModel:FindFirstChild(\"HumanoidRootPart\")\n\tif not hrp then return true end\n\t\n\tlocal clientPos = hrp.Position\n\tlocal serverPos = posAttribute\n\t\n\t\n\tlocal distance = (clientPos - serverPos).Magnitude\n\t\n\t\n\tif distance > 10 then\n\t\treturn false\n\tend\n\t\n\treturn true\nend\n\n\nlocal function performShot(rayOrigin, targetPos, spreadAlreadyApplied, isManualShot)\n\tif isActTriggered() then\n\t\treturn\n\tend\n\tif not canFireShot() then \n\t\treturn \n\tend\n\n\t\n\t\n\t\n\tlocal originalTargetPos = targetPos \n\tif not spreadAlreadyApplied then\n\t\t\n\t\t\n\t\tlocal currentSpread = getCurrentSpread()\n\t\t\n\t\t\n\t\ttargetPos = applySpread(targetPos, rayOrigin, currentSpread)\n\tend\n\n\t\n\tlocal direction = (targetPos - rayOrigin).Unit\n\tlocal bulletRayParams = getCachedRaycastParams()\n\t\n\t\n\tlocal currentOrigin = rayOrigin\n\tlocal currentDirection = direction\n\tlocal remainingDistance = 160\n\tlocal passedThroughPenetrable = false\n\t\n\t\n\tlocal firstRayResult = workspace:Raycast(rayOrigin, direction * 160, bulletRayParams)\n\tlocal function isPointInsidePartFast(part, worldPos)\n\t\tif not part or not part:IsA(\"BasePart\") then return false end\n\t\tlocal localPos = part.CFrame:PointToObjectSpace(worldPos)\n\t\tlocal s = part.Size\n\t\treturn math.abs(localPos.X) <= s.X * 0.5 and math.abs(localPos.Y) <= s.Y * 0.5 and math.abs(localPos.Z) <= s.Z * 0.5\n\tend\n\t\n\tif firstRayResult and firstRayResult.Instance and isPointInsidePartFast(firstRayResult.Instance, rayOrigin) then\n\t\tlocal exitPoint = getExitPoint(firstRayResult.Instance, rayOrigin, direction)\n\t\tif exitPoint then\n\t\t\tlocal delta = (exitPoint - rayOrigin).Magnitude + 0.01\n\t\t\tcurrentOrigin = exitPoint + direction * 0.01\n\t\t\tremainingDistance = math.max(0, 160 - delta)\n\t\tend\n\tend\n\t\n\t\n\tlocal finalParams = RaycastParams.new()\n\tfinalParams.FilterType = Enum.RaycastFilterType.Exclude\n\tlocal finalBlacklist = {}\n\tfor _, inst in ipairs(getCachedBlacklist()) do table.insert(finalBlacklist, inst) end\n\tfor _, pen in ipairs(getPenetrableWhitelist()) do table.insert(finalBlacklist, pen) end\n\tfinalParams.FilterDescendantsInstances = finalBlacklist\n\t\n\t\n\tlocal tempBulletHoles = {}\n\tlocal tempBlacklist = {}\n\tfor _, inst in ipairs(getCachedBlacklist()) do table.insert(tempBlacklist, inst) end\n\t\n\twhile remainingDistance > 0 do\n\t\tlocal penetrableResult, hitPos, hitNormal = checkPenetrableAlongRay(currentOrigin, currentDirection, remainingDistance, tempBulletHoles)\n\t\tif penetrableResult then\n\t\t\tpassedThroughPenetrable = true\n\t\t\t\n\t\t\t\n\t\t\ttable.insert(tempBlacklist, penetrableResult.Instance)\n\t\t\t\n\t\t\tlocal exitPoint = getExitPoint(penetrableResult.Instance, hitPos, currentDirection)\n\t\t\tif exitPoint then\n\t\t\t\tcurrentOrigin = exitPoint + currentDirection * 0.01\n\t\t\t\tremainingDistance = remainingDistance - (exitPoint - hitPos).Magnitude - 0.01\n\t\t\telse\n\t\t\t\tbreak\n\t\t\tend\n\t\telse\n\t\t\tbreak\n\t\tend\n\tend\n\t\n\t\n\tlocal finalResult = workspace:Raycast(currentOrigin, currentDirection * remainingDistance, finalParams)\n\tlocal hitModel = nil\n\tlocal hitPartName = \"Default\"\n\tlocal distance = 160\n\t\n\tif finalResult then\n\t\thitModel = finalResult.Instance:FindFirstAncestorOfClass(\"Model\")\n\t\tif hitModel and hitModel:FindFirstChildOfClass(\"Humanoid\") then\n\t\t\thitPartName = getBodyPartName(finalResult.Instance)\n\t\t\tdistance = (finalResult.Position - rayOrigin).Magnitude\n\t\tend\n\telse\n\t\tdistance = (currentOrigin + currentDirection * remainingDistance - rayOrigin).Magnitude\n\tend\n\n\t\n\tif hitModel and hitModel:FindFirstChildOfClass(\"Humanoid\") then\n\t\tif not checkTargetPositionSync(hitModel) then\n\t\t\treturn \n\t\tend\n\tend\n\n\t\n\tif hitModel and hitModel:FindFirstChildOfClass(\"Humanoid\") then\n\t\tlocal mindmgBool = player:FindFirstChild(\"MindmgBool\")\n\t\tlocal mindmgValue = player:FindFirstChild(\"Mindmg\")\n\t\tlocal mindmgOverrideBool = player:FindFirstChild(\"mindmgoverride\")\n\t\tlocal mindmgOverrideValue = player:FindFirstChild(\"mindmgoverridevalue\")\n\t\t\n\t\t\n\t\tlocal activeMindmgValue = mindmgValue\n\t\tlocal isOverride = false\n\t\tif mindmgOverrideBool and mindmgOverrideBool.Value and mindmgOverrideValue and mindmgOverrideValue:IsA(\"IntValue\") then\n\t\t\tactiveMindmgValue = mindmgOverrideValue\n\t\t\tisOverride = true\n\t\tend\n\t\t\n\t\tif mindmgBool and mindmgBool.Value and activeMindmgValue and activeMindmgValue:IsA(\"IntValue\") and activeMindmgValue.Value > 0 then\n\t\t\tlocal rawDamage = calculateClientDamage(distance, passedThroughPenetrable, hitPartName)\n\t\t\t\n\t\t\t\n\t\t\tlocal data = hitModel:FindFirstChild(\"Data\")\n\t\t\tlocal armorValue = 0\n\t\t\tif data then\n\t\t\t\tlocal armor = data:FindFirstChild(\"Armor\")\n\t\t\t\tif armor and armor:IsA(\"IntValue\") then\n\t\t\t\t\tarmorValue = armor.Value\n\t\t\t\tend\n\t\t\tend\n\t\t\t\n\t\t\t\n\t\t\tlocal _, _, healthDamage, _ = calculateClientDamageWithArmor(rawDamage, armorValue, hitPartName)\n\t\t\t\n\t\t\t\n\t\t\tlocal humanoid = hitModel:FindFirstChildOfClass(\"Humanoid\")\n\t\t\tlocal currentHealth = humanoid and humanoid.Health or 0\n\t\t\t\n\t\t\t\n\t\t\t\n\t\t\tif healthDamage < activeMindmgValue.Value and healthDamage < currentHealth then\n\t\t\t\treturn \n\t\t\tend\n\t\ten