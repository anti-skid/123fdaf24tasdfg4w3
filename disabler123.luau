        if not (skyTab and skyTab.AddPage) then return end\n        local leftPage = skyTab:AddPage(\"left\", \"Rotation\")\n        local rightPage = skyTab:AddPage(\"right\", \"Skybox Rotate\")\n\n        local Lighting = game:GetService(\"Lighting\")\n        local xAngle, yAngle, zAngle = 0, 0, 0\n        local rotEnabled = false\n        local axisX, axisY, axisZ = true, true, false\n        local rotSpeed = 1\n\n        local function getAllSkies()\n            local skies = {}\n            local seen = {}\n            \n            for _, child in ipairs(Lighting:GetChildren()) do\n                if child:IsA(\"Sky\") and not seen[child] then\n                    table.insert(skies, child)\n                    seen[child] = true\n                end\n            end\n            \n            local skysFolder = Lighting:FindFirstChild(\"Skys\")\n            if skysFolder then\n                for _, child in ipairs(skysFolder:GetChildren()) do\n                    if child:IsA(\"Sky\") and not seen[child] then\n                        table.insert(skies, child)\n                        seen[child] = true\n                    end\n                end\n            end\n            return skies\n        end\n\n        local function applySkyOrientation(anim)\n            local skies = getAllSkies()\n            if #skies == 0 then return end\n            local ax = anim and (axisX and anim.X or 0) or 0\n            local ay = anim and (axisY and anim.Y or 0) or 0\n            local az = anim and (axisZ and anim.Z or 0) or 0\n            local final = Vector3.new(xAngle + ax, yAngle + ay, zAngle + az)\n            for _, sky in ipairs(skies) do\n                pcall(function()\n                    sky.SkyboxOrientation = final\n                end)\n            end\n        end\n\n        leftPage:AddSlider(\"Rotate X\", 0, -180, 180, 1, function(v)\n            xAngle = tonumber(v) or 0\n            applySkyOrientation(nil)\n        end)\n        leftPage:AddS