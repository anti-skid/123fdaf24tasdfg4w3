n\t\n\tlocal direction = (targetPos - rayOrigin).Unit\n\tlocal distance = (targetPos - rayOrigin).Magnitude\n\t\n\t\n\tlocal randomAngle1 = math.random() * math.pi * 2\n\tlocal randomAngle2 = math.acos(2 * math.random() - 1) \n\tlocal randomRadius = spread * math.sqrt(math.random()) \n\t\n\t\n\tlocal right = direction:Cross(Vector3.new(0, 1, 0))\n\tif right.Magnitude < 0.1 then\n\t\tright = direction:Cross(Vector3.new(1, 0, 0))\n\tend\n\tright = right.Unit\n\tlocal up = right:Cross(direction).Unit\n\t\n\t\n\tlocal offset = right * (math.cos(randomAngle1) * math.sin(randomAngle2) * randomRadius) +\n\t               up * (math.sin(randomAngle1) * math.sin(randomAngle2) * randomRadius) +\n\t               direction * (math.cos(randomAngle2) * randomRadius)\n\t\n\treturn targetPos + offset\nend\n\n\nlocal function canShootWithHitchance()\n\tlocal hitchanceValue = player:FindFirstChild(\"Hitchance\")\n\tif not hitchanceValue or not hitchanceValue:IsA(\"IntValue\") then\n\t\treturn true \n\tend\n\t\n\tlocal hitchance = hitchanceValue.Value\n\tlocal currentSpread = getCurrentSpread()\n\t\n\t\n\t\n\t\n\tlocal realMinSpread = 0.2\n\tlocal maxAllowedSpread = realMinSpread + (SpreadConfig.MaxSpread - realMinSpread) * (1 - hitchance / 100)\n\t\n\treturn currentSpread <= maxAllowedSpread\nend\n\nlocal function findSSGTool()\n    local character = player.Character\n    if character then\n        local t = character:FindFirstChild(\"SSG-08\")\n        if t then return t end\n    end\n    local bp = player:FindFirstChild(\"Backpack\")\n    return bp and bp:FindFirstChild(\"SSG-08\") or nil\nend\n\n\nlocal function getSelectedHitSound()\n    local hitsoundValue = player:FindFirstChild(\"Hitsound\")\n    local soundName = hitsoundValue and hitsoundValue.Value or \"Neverlose\"\n    return hitSoundsFolder:FindFirstChild(soundName)\nend\n\nlocal function getSelectedKillSound()\n    local killsoundValue = player:FindFirstChild(\"Killsound\")\n    local soundName = killsoundValue and killsoundValue.Value or \"Original\"\n    return killSoundsFolder:FindFirstChild(soundName)\nend\n\n\nlocal function getSelectedHitEffect()\n    local hiteffectValue = player:FindFirstChild(\"Hiteffect\")\n    local effectName = hiteffectValue and hiteffectValue.Value or \"None\"\n    if effectName == \"None\" then\n        return nil\n    end\n    \n    local effectsFolder = workspace:FindFirstChild(\"Effects\")\n    if not effectsFolder then\n        return nil\n    end\n    \n    return effectsFolder:FindFirstChild(effectName)\nend\n\nlocal function getSelectedKillEffect()\n    local killeffectValue = player:FindFirstChild(\"Killeffect\")\n    local effectName = killeffectValue and killeffectValue.Value or \"None\"\n    if effectName == \"None\" then\n        return nil\n    end\n    \n    local effectsFolder = workspace:FindFirstChild(\"Effects\")\n    if not effectsFolder then\n        return nil\n    end\n    \n    return effectsFolder:FindFirstChild(effectName)\nend\n\n\nlocal function createEffectAtPosition(effectTemplate, targetHRP, isKillEffect)\n    if not effectTemplate or not targetHRP then return end\n    \n    \n    local timeoutValueName = isKillEffect and \"KilleffectTimeout\" or \"HiteffectTimeout\"\n    local timeoutValue = player:FindFirstChild(timeoutValueName)\n    local timeout = (timeoutValue and timeoutValue:IsA(\"NumberValue\") and timeoutValue.Value) or 1.0\n    timeout = math.clamp(timeout, 0.1, 3.0)\n    \n    \n    local effectPart = nil\n    if effectTemplate:IsA(\"BasePart\") then\n        effectPart = effectTemplate\n    else\n        \n        for _, child in ipairs(effectTemplate:GetChildren()) do\n            if child:IsA(\"BasePart\") then\n                effectPart = child\n                break\n            end\n        end\n    end\n    \n    if not effectPart then return end\n    \n    \n    local clonedPart = effectPart:Clone()\n    \n    \n    clonedPart.Size = Vector3.new(1, 1, 1)\n    clonedPart.CanCollide = false\n    clonedPart.Transparency = 1\n    clonedPart.Anchored = true\n    clonedPart.Position = targetHRP.Position\n    clonedPart.Parent = workspace\n    \n    \n    local particleEmitters = {}\n    for _, descendant in ipairs(clonedPart:GetDescendants()) do\n        if descendant:IsA(\"ParticleEmitter\") then\n            table.insert(particleEmitters, descendant)\n        end\n    end\n    \n    \n    for _, emitter in ipairs(particleEmitters) do\n        emitter.Enabled = true\n    end\n    \n    \n    task.delay(timeout, function()\n        for _, emitter in ipairs(particleEmitters) do\n            if emitter and emitter.Parent then\n                emitter.Enabled = false\n            end\n        end\n        \n        \n        task.delay(timeout, function()\n            if clonedPart and clonedPart.Parent then\n                clonedPart:Destroy()\n            end\n        end)\n    end)\nend\n\n\nlocal computeNeckFireOrigin\n\nlocal function getClosestPlayer(position)\n\tlocal best, bestDist = nil, math.huge\n\tlocal maxDistance = 500 \n\t\n\tfor _, other in ipairs(Players:GetPlayers()) do\n\t\tif other ~= player and other.Character and other.Character.Parent then\n\t\t\tlocal head = other.Character:FindFirstChild(\"Head\")\n\t\t\tlocal humanoid = other.Character:FindFirstChildOfClass(\"Humanoid\")\n\t\t\t\n\t\t\tif head and head.Parent and humanoid and humanoid.Parent then\n\t\t\t\t\n\t\t\t\tif humanoid:GetState() ~= Enum.HumanoidStateType.Dead and humanoid.Health > 0 and not other.Character:FindFirstChildOfClass(\"ForceField\") then\n\t\t\t\t\tlocal dist = (head.Position - position).Magnitude\n\t\t\t\t\tif dist <= maxDistance and dist < bestDist then\n\t\t\t\t\t\tbest = other.Character\n\t\t\t\t\t\tbestDist = dist\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\n\t\n\treturn best\nend\n\nlocal function getTargetPosition()\n\tlocal success, result = pcall(function()\n\t\tlocal char = player.Character\n\t\tif not char or not char.Parent then\n\t\t\tlocal cam = workspace.CurrentCamera\n\t\t\tlocal mouse = player:GetMouse()\n\t\t\tif cam and mouse and mouse.Hit then\n\t\t\t\tlocal dir = mouse.Hit.LookVector\n\t\t\t\treturn cam.CFrame.Position + dir * 1000\n\t\t\tend\n\t\t\treturn Vector3.new(0,0,0)\n\t\tend\n\t\t\n\t\t\n\t\tlocal hitpartValue = player:FindFirstChild(\"hitpart\")\n\t\tlocal hitpartModeValue = player:FindFirstChild(\"hitpartMode\")\n\t\tlocal selectedHitpart = hitpartValue and hitpartValue.Value or \"Head\"\n\t\tlocal hitpartMode = hitpartModeValue and hitpartModeValue.Value or \"Fixed\"\n\t\t\n\t\t\n\t\tlocal aimModeValue = char:FindFirstChild(\"aimMode\")\n\t\tlocal aimMode = aimModeValue and aimModeValue.Value or \"closest to plr\"\n\t\t\n\t\tlocal bestTarget = nil\n\t\tlocal bestDistance = math.huge\n\t\t\n\t\t\n\t\tfor _, other in ipairs(Players:GetPlayers()) do\n\t\t\tif other ~= player and other.Character and other.Character.Parent then\n\t\t\t\tlocal humanoid = other.Character:FindFirstChildOfClass(\"Humanoid\")\n\t\t\t\tif humanoid and humanoid.Health > 0 and humanoid:GetState() ~= Enum.HumanoidStateType.Dead and not other.Character:FindFirstChildOfClass(\"ForceField\") then\n\t\t\t\t\tlocal head = other.Character:FindFirstChild(\"Head\")\n\t\t\t\t\tif head and head.Parent then\n\t\t\t\t\t\t\n\t\t\t\t\t\tlocal rayOrigin = computeNeckFireOrigin(head.Position)\n\t\t\t\t\t\tlocal toHead = head.Position - rayOrigin\n\t\t\t\t\t\tlocal distance = toHead.Magnitude\n\t\t\t\t\t\tif distance <= 200 then \n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\tlocal cam = workspace.CurrentCamera\n\t\t\t\t\t\t\tlocal fovPenalty = 0\n\t\t\t\t\t\t\tif cam then\n\t\t\t\t\t\t\t\tlocal forward = cam.CFrame.LookVector\n\t\t\t\t\t\t\t\tlocal cosAngle = math.clamp(forward:Dot((head.Position - cam.CFrame.Position).Unit), -1, 1)\n\t\t\t\t\t\t\t\tlocal angleDeg = math.deg(math.acos(cosAngle))\n\t\t\t\t\t\t\t\tfovPenalty = math.max(0, angleDeg - 60) * 5\n\t\t\t\t\t\t\tend\n\t\t\t\t\t\t\tlocal priority = distance + fovPenalty\n\t\t\t\t\t\t\tif aimMode == \"closest to cursor\" then\n\t\t\t\t\t\t\t\tlocal mouse = player:GetMouse()\n\t\t\t\t\t\t\t\tif mouse and mouse.Hit then\n\t\t\t\t\t\t\t\t\tpriority = (head.Position - mouse.Hit.Position).Magnitude + fovPenalty\n\t\t\t\t\t\t\t\tend\n\t\t\t\t\t\t\tend\n\t\t\t\t\t\t\tif priority < bestDistance then\n\t\t\t\t\t\t\t\tbestDistance = priority\n\t\t\t\t\t\t\t\tbestTarget = other.Character\n\t\t\t\t\t\t\tend\n\t\t\t\t\t\tend\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\t\t\n\t\tif bestTarget and bestTarget.Parent then\n\t\t\tif selectedHitpart == \"Closest part\" then\n\t\t\t\tlocal bestPart = nil\n\t\t\t\tlocal bestScore = -math.huge\n\t\t\t\tlocal bodyParts = {\n\t\t\t\t\t{name = \"Head\", priority = 100, part = bestTarget:FindFirstChild(\"Head\")},\n\t\t\t\t\t{name = \"Torso\", priority = 80, part = bestTarget:FindFirstChild(\"Torso\")},\n\t\t\t\t\t{name = \"Left Arm\", priority = 60, part = bestTarget:FindFirstChild(\"Left Arm\")},\n\t\t\t\t\t{name = \"Right Arm\", priority = 60, part = bestTarget:FindFirstChild(\"Right Arm\")},\n\t\t\t\t\t{name = \"Left Leg\", priority = 40, part = bestTarget:FindFirstChild(\"Left Leg\")},\n\t\t\t\t\t{name = \"Right Leg\", priority = 40, part = bestTarget:FindFirstChild(\"Right Leg\")}\n\t\t\t\t}\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\tlocal originForVis = computeNeckFireOrigin(bestTarget:FindFirstChild(\"Head\").Position)\n\t\t\t\tlocal visParams = getCachedRaycastParams()\n\t\t\t\t\n\t\t\t\t\n\t\t\t\tfor _, partData in ipairs(bodyParts) do\n\t\t\t\t\tlocal part = partData.part\n\t\t\t\t\tif part and part.Parent then\n\t\t\t\t\t\tlocal candidatePoint\n\t\t\t\t\t\tif hitpartMode == \"Fixed\" then\n\t\t\t\t\t\t\tcandidatePoint = part.Position\n\t\t\t\t\t\telse \n\t\t\t\t\t\t\tlocal partCFrame = part.CFrame\n\t\t\t\t\t\t\tlocal partSize = part.Size\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\tlocal localOrigin = partCFrame:PointToObjectSpace(originForVis)\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\tlocal closestLocalPos = Vector3.new(\n\t\t\t\t\t\t\t\tmath.max(-partSize.X/2, math.min(partSize.X/2, localOrigin.X)),\n\t\t\t\t\t\t\t\tmath.max(-partSize.Y/2, math.min(partSize.Y/2, localOrigin.Y)),\n\t\t\t\t\t\t\t\tmath.max(-partSize.Z/2, math.min(partSize.Z/2, localOrigin.Z))\n\t\t\t\t\t\t\t)\n\t\t\t\t\t\t\tcandidatePoint = partCFrame:PointToWorldSpace(closestLocalPos)\n\t\t\t\t\t\tend\n\t\t\t\t\t\t\n\t\t\t\t\t\t\n\t\t\t\t\t\tlocal dir = candidatePoint - originForVis\n\t\t\t\t\t\tlocal dist = dir.Magnitude\n\t\t\t\t\t\tif dist > 1e-3 then\n\t\t\t\t\t\t\tlocal res = workspace:Raycast(originForVis, dir.Unit * math.min(dist, 1000), visParams)\n\t\t\t\t\t\t\tif res then\n\t\t\t\t\t\t\t\tlocal hitModel = res.Instance:FindFirstAncestorOfClass(\"Model\")\n\t\t\t\t\t\t\t\tif hitModel == bestTarget and (res.Instance == part or res.Instance:IsDescendantOf(part)) then\n\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\tlocal distanceFromOrigin = dist\n\t\t\t\t\t\t\t\t\tlocal score = partData.priority - (distanceFromOrigin * 0.1)\n\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\tif score > bestScore then\n\t\t\t\t\t\t\t\t\t\tbestScore = score\n\t\t\t\t\t\t\t\t\t\tbestPart = {part = part, point = candidatePoint}\n\t\t\t\t\t\t\t\t\tend\n\t\t\t\t\t\t\t\tend\n\t\t\t\t\t\t\tend\n\t\t\t\t\t\tend\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\t\t\n\t\t\t\tif bestPart then\n\t\t\t\t\tif hitpartMode == \"Fixed\" then\n\t\t\t\t\t\treturn bestPart.part.Position\n\t\t\t\t\telseif hitpartMode == \"Closest\" then\n\t\t\t\t\t\t\n\t\t\t\t\t\treturn bestPart.point\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\telse\n\t\t\t\t\n\t\t\t\tlocal targetPart = bestTarget:FindFirstChild(selectedHitpart)\n\t\t\t\tif targetPart and targetPart.Parent then\n\t\t\t\t\tif hitpartMode == \"Fixed\" then\n\t\t\t\t\t\t\n\t\t\t\t\t\treturn targetPart.Position\n\t\t\t\t\telseif hitpartMode == \"Closest\" then\n\t\t\t\t\t\t\n\t\t\t\t\t\tlocal originForVis = computeNeckFireOrigin(targetPart.Position)\n\t\t\t\t\t\tlocal partCFrame = targetPart.CFrame\n\t\t\t\t\t\tlocal partSize = targetPart.Size\n\t\t\t\t\t\t\n\t\t\t\t\t\t\n\t\t\t\t\t\tlocal localOrigin = partCFrame:PointToObjectSpace(originForVis)\n\t\t\t\t\t\t\n\t\t\t\t\t\t\n\t\t\t\t\t\tlocal yOffset = 0\n\t\t\t\t\t\tif selectedHitpart == \"Head\" then\n\t\t\t\t\t\t\tyOffset = partSize.Y * 0.2 \n\t\t\t\t\t\tend\n\t\t\t\t\t\t\n\t\t\t\t\t\t\n\t\t\t\t\t\tlocal closestLocalPos = Vector3.new(\n\t\t\t\t\t\t\tmath.max(-partSize.X/2, math.min(partSize.X/2, localOrigin.X)),\n\t\t\t\t\t\t\tmath.max(-partSize.Y/2 + yOffset, math.min(partSize.Y/2, localOrigin.Y)),\n\t\t\t\t\t\t\tmath.max(-partSize.Z/2, math.min(partSize.Z/2, localOrigin.Z))\n\t\t\t\t\t\t)\n\t\t\t\t\t\t\n\t\t\t\t\t\tlocal closestPoint = partCFrame:PointToWorldSpace(closestLocalPos)\n\t\t\t\t\t\t\n\t\t\t\t\t\t\n\t\t\t\t\t\tlocal visParams = getCachedRaycastParams()\n\t\t\t\t\t\tlocal dir = closestPoint - originForVis\n\t\t\t\t\t\tlocal dist = dir.Magnitude\n\t\t\t\t\t\tif dist > 1e-3 then\n\t\t\t\t\t\t\tlocal res = workspace:Raycast(originForVis, dir.Unit * math.min(dist, 1000), visParams)\n\t\t\t\t\t\t\tif res then\n\t\t\t\t\t\t\t\tlocal hitModel = res.Instance:FindFirstAncestorOfClass(\"Model\")\n\t\t\t\t\t\t\t\tif hitModel == bestTarget and (res.Instance == targetPart or res.Instance:IsDescendantOf(targetPart)) then\n\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\treturn closestPoint\n\t\t\t\t\t\t\t\tend\n\t\t\t\t\t\t\tend\n\t\t\t\t\t\tend\n\t\t\t\t\t\t\n\t\t\t\t\t\t\n\t\t\t\t\t\treturn targetPart.Position\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\t\t\n\t\t\n\t\tlocal cam = workspace.CurrentCamera\n\t\tlocal mouse = player:GetMouse()\n\t\tif cam and mouse and mouse.Hit then\n\t\t\tlocal dir = mouse.Hit.LookVector\n\t\t\treturn cam.CFrame.Position + dir * 1000\n\t\tend\n\t\treturn Vector3.new(0,0,0)\n\tend)\n\t\n\tif success then\n\t\treturn result\n\telse\n\t\tprint(\"Error in getTargetPosition:\", result)\n\t\treturn Vector3.new(0,0,0)\n\tend\nend\n\nlocal tool = nil\n\nlocal debugBeam = nil\nlocal debugAttachment0 = nil\nlocal debugAttachment1 = nil\nlocal debugUpdateCounter = 0\n\n\nlocal spreadDebugSphere = nil\nlocal spreadDebugBillboard = nil\n\n\nlocal overrideIndicatorGui = nil\nlocal overrideIndicatorLabel = nil\n\nlocal function createOverrideIndicator()\n\tif overrideIndicatorGui then\n\t\toverrideIndicatorGui:Destroy()\n\tend\n\t\n\toverrideIndicatorGui = Instance.new(\"ScreenGui\")\n\toverrideIndicatorGui.Name = \"MinDmgIndicator\"\n\toverrideIndicatorGui.ResetOnSpawn = false\n\toverrideIndicatorGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling\n\toverrideIndicatorGui.DisplayOrder = 9999\n\tpcall(function() overrideIndicatorGui.IgnoreGuiInset = true end)\n\toverrideIndicatorGui.Parent = PlayerGui\n\t\n\toverrideIndicatorLabel = Instance.new(\"TextLabel\")\n\toverrideIndicatorLabel.Size = UDim2.new(0, 250, 0, 35)\n\toverrideIndicatorLabel.AnchorPoint = Vector2.new(0, 1)\n\toverrideIndicatorLabel.Position = UDim2.new(0, 40, 1, -160)\n\toverrideIndicatorLabel.BackgroundTransparency = 1\n\toverrideIndicatorLabel.Text = \"MinDmg Override\"\n\toverrideIndicatorLabel.TextColor3 = Color3.fromRGB(255, 255, 255)\n\toverrideIndicatorLabel.TextSize = 25\n\toverrideIndicatorLabel.Font = Enum.Font.GothamBold\n\toverrideIndicatorLabel.TextXAlignment = Enum.TextXAlignment.Left\n\toverrideIndicatorLabel.TextYAlignment = Enum.TextYAlignment.Center\n\toverrideIndicatorLabel.Parent = overrideIndicatorGui\n\t\n\t\n\tlocal textStroke = Instance.new(\"UIStroke\")\n\ttextStroke.Thickness = 1\n\ttextStroke.Color = Color3.fromRGB(0, 0, 0)\n\ttextStroke.Transparency = 0\n\ttextStroke.Parent = overrideIndicatorLabel\n\t\n\toverrideIndicatorGui.Enabled = false\nend\n\nlocal function updateOverrideIndicator()\n\tif not overrideIndicatorGui or not overrideIndicatorLabel then\n\t\tcreateOverrideIndicator()\n\tend\n\t\n\tlocal mindmgOverrideBool = player:FindFirstChild(\"mindmgoverride\")\n\t\n\tif mindmgOverrideBool and mindmgOverrideBool.Value then\n\t\toverrideIndicatorLabel.Text = \"MinDmg Override\"\n\t\toverrideIndicatorLabel.TextColor3 = Color3.fromRGB(255, 255, 255)\n\t\toverrideIndicatorGui.Enabled = true\n\telse\n\t\toverrideIndicatorGui.Enabled = false\n\tend\nend\n\n\ncreateOverrideIndicator()\n\n\nlocal overrideBoolConn = nil\n\nlocal function setupOverrideListeners()\n\t\n\tif overrideBoolConn then\n\t\toverrideBoolConn:Disconnect()\n\t\toverrideBoolConn = nil\n\tend\n\t\n\t\n\tlocal overrideBool = player:FindFirstChild(\"mindmgoverride\")\n\t\n\tif overrideBool then\n\t\toverrideBoolConn = overrideBool.Changed:Connect(updateOverrideIndicator)\n\t\tupdateOverrideIndicator()\n\tend\nend\n\nplayer.ChildAdded:Connect(function(child)\n\tif child.Name == \"mindmgoverride\" then\n\t\ttask.wait(0.1)\n\t\tsetupOverrideListeners()\n\tend\nend)\n\n\ntask.delay(0.5, setupOverrideListeners)\n\n\n\nlocal canShoot = true\nlocal lastShotTime = 0\nlocal isReloading = false\nlocal SHOT_COOLDOWN = 0.1\nlocal RELOAD_TIME = 0\n\nlocal isMobile = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled\n\ncomputeNeckFireOrigin = function(targetPos)\n    local character = player.Character\n    local hrp = character and character:FindFirstChild(\"HumanoidRootPart\")\n    if not hrp then\n        local cam = workspace.CurrentCamera\n        return cam and cam.CFrame.Position or targetPos\n    end\n\n    local center = hrp.CFrame.Position + Vector3.new(0, 1, 0)\n    local cf = hrp.CFrame\n    local right = cf.RightVector\n    local forward = cf.LookVector\n    local halfX, halfZ = 0.5, 0.5 \n\n    local candidates = {\n        center,\n        center + right * halfX,\n        center - right * halfX,\n        center + forward * halfZ,\n        center - forward * halfZ,\n        center + right * halfX + forward * halfZ,\n        center + right * halfX - forward * halfZ,\n        center - right * halfX + forward * halfZ,\n        center - right * halfX - forward * halfZ,\n    }\n\n    local params = getCachedRaycastParams()\n    local function isInsideNonPenetrable(pos)\n        local overlap = OverlapParams.new()\n        overlap.FilterType = Enum.RaycastFilterType.Exclude\n        local exclude = {}\n        if player.Character then table.insert(exclude, player.Character) end\n        overlap.FilterDescendantsInstances = exclude\n        local parts = workspace:GetPartBoundsInRadius(pos, 0.25, overlap)\n        for _, part in ipairs(parts) do\n            if part:IsA(\"BasePart\") and part.Name ~= \"Penetrable\" then\n                return true\n            end\n        end\n        return false\n    end\n\n    local bestOrigin = center\n    local bestClearance = -math.huge\n\n    for _, origin in ipairs(candidates) do\n        if not isInsideNonPenetrable(origin) then\n            local dir = targetPos - origin\n            local dist = dir.Magnitude\n            if dist > 1e-3 then\n                local res = workspace:Raycast(origin, dir.Unit * math.min(dist, 1000), params)\n                if not res then\n                    return origin\n                else\n                    local hitDist = (res.Position - origin).Magnitude\n                    if hitDist > bestClearance then\n                        bestClearance = hitDist\n                        bestOrigin = origin\n                    end\n                end\n            end\n        end\n    end\n\n    if isInsideNonPenetrable(bestOrigin) then\n        local nudged = bestOrigin:Lerp(center, 0.5)\n        if not isInsideNonPenetrable(nudged) then\n            return nudged\n        end\n        local cam = workspace.CurrentCamera\n        if cam then\n            local try = bestOrigin\n            for i = 1, 4 do\n                try = try - cam.CFrame.LookVector * 0.25\n                if not isInsideNonPenetrable(try) then\n                    return try\n                end\n            end\n        end\n        return center\n    end\n\n    return bestOrigin\nend\n\n\nlocal function castAimRay(origin, targetPos)\n    if not origin or not targetPos then return nil, origin end\n    local dir = targetPos - origin\n    local dist = dir.Magnitude\n    if dist < 1e-3 then return nil, origin end\n    local params = RaycastParams.new()\n    params.FilterType = Enum.RaycastFilterType.Exclude\n    local exclude = {}\n    for _, inst in ipairs(getCachedBlacklist()) do table.insert(exclude, inst) end\n    for _, pen in ipairs(getPenetrableWhitelist()) do table.insert(exclude, pen) end\n    params.FilterDescendantsInstances = exclude\n    local result = workspace:Raycast(origin, dir.Unit * math.min(dist, 1000), params)\n    local endPos = result and result.Position or (origin + dir.Unit * math.min(dist, 1000))\n    return result, endPos\nend\n\nlocal function isInJoystickArea(touchPosition)\n\tif not touchPosition or not touchPosition.X or not touchPosition.Y then\n\t\treturn false\n\tend\n\n\t\n\tlocal screenSize = workspace.CurrentCamera.ViewportSize\n\t\n\tlocal joystickArea = {\n\t\tx = 0,\n\t\ty = screenSize.Y * 0.6, \n\t\twidth = screenSize.X * 0.3, \n\t\theight = screenSize.Y * 0.4 \n\t}\n\n\treturn touchPosition.X >= joystickArea.x and \n\t\ttouchPosition.X <= joystickArea.x + joystickArea.width and\n\t\ttouchPosition.Y >= joystickArea.y and \n\t\ttouchPosition.Y <= joystickArea.y + joystickArea.height\nend\n\n\nlocal function isCameraControl(touchPosition)\n\tif not touchPosition or not touchPosition.X or not touchPosition.Y then\n\t\treturn false\n\tend\n\n\t\n\tlocal screenSize = workspace.CurrentCamera.ViewportSize\n\t\n\tlocal cameraArea = {\n\t\tx = screenSize.X * 0.7, \n\t\ty = 0,\n\t\twidth = screenSize.X * 0.3, \n\t\theight = screenSize.Y * 0.6 \n\t}\n\n\treturn touchPosition.X >= cameraArea.x and \n\t\ttouchPosition.X <= cameraArea.x + cameraArea.width and\n\t\ttouchPosition.Y >= cameraArea.y and \n\t\ttouchPosition.Y <= cameraArea.y + cameraArea.height\nend\n\nlocal function createTempPart(position)\n\tlocal part = Instance.new(\"Part\")\n\tpart.Name = \"Bullet\"\n\tpart.Size = Vector3.new(0.2, 0.2, 0.2)\n\tpart.Position = position\n\tpart.Transparency = 1\n\